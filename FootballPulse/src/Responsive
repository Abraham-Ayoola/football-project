@media (max-width: 1100px) {
  .desktop-nav {
    gap: 18px;
  }
  .competition-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .team-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .why-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 800px) {
  .navbar {
    padding: 0 5%;
  }
  .desktop-nav {
    display: none;
  }
  .menu-btn {
    display: block;
  }
  .hero {
    min-height: 680px;
    padding: 80px 5%;
  }
  .hero h1 {
    font-size: 55px;
    letter-spacing: -2px;
  }
  .hero p {
    font-size: 16px;
  }
  .hero-buttons {
    flex-direction: column;
    max-width: 300px;
  }
  .hero-stats {
    gap: 25px;
  }
  .section {
    padding: 70px 5%;
  }
  .section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 20px;
  }
  .section-heading h2 {
    font-size: 34px;
  }
  .match-grid {
    grid-template-columns: 1fr;
  }
  .fixture-card {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 12px;
  }
  .fixture-date {
    align-items: center;
  }
  .fixture-team {
    justify-content: center;
  }
  .competition-grid {
    grid-template-columns: 1fr;
  }
  .team-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .news-grid {
    grid-template-columns: 1fr;
  }
  .statistics-content {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .statistics-content h2 {
    font-size: 38px;
  }
  .why-grid {
    grid-template-columns: 1fr;
  }
  .why-heading h2 {
    font-size: 37px;
  }
  .cta-content h2 {
    font-size: 45px;
  }
  .footer-top {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 500px) {
  logo {
    font-size: 20px;
  }
  .search-btn {
    display: none;
  }
  .login-btn {
    padding: 9px 15px;
  }
  .hero {
    min-height: 650px;
  }
  .hero h1 {
    font-size: 48px;
  }
  .hero-stats {
    gap: 18px;
  }
  .hero-stats strong {
    grid-template-columns: 1fr 1fr;
  }
  .statistics-grid {
    grid-template-columns: 1fr;
  }
  .footer-top {
    grid-template-columns: 1fr;
  }
  .footer-bottom {
    flex-direction: column;
    gap: 10px;
  }
}
